# Copy this file to backend/.env and fill in your values. Never commit .env.
# Leave DATABASE_URL unset to use the local SQLite file (backend/wagashelf.db).
# DATABASE_URL=postgresql://user:password@host/dbname

# Your Clerk instance's Frontend API URL (Clerk dashboard > API keys > "Frontend API URL").
CLERK_ISSUER=https://your-instance.clerk.accounts.dev
# Websites allowed to use sign-in tokens and call the API (comma-separated).
CLERK_AUTHORIZED_PARTIES=http://localhost:5173
FRONTEND_ORIGINS=http://localhost:5173
